# Copy to .env for local use. On Render, render.yaml lists what the service needs
# and the dashboard asks for the values (Environment tab).
# Every one is optional. With none set, the app serves offline single-student
# practice, which is the whole app minus accounts and AI.

# --- Accounts and cross-device progress ---
# On Render, render.yaml wires this to the database's internal URL for you.
DATABASE_URL=postgresql://user:pass@host:5432/lockin

# --- Sending the 6 digit sign-in code ---
# With nothing set here, the code is written to the server log instead of
# emailed, which is enough for testing. Once STRIPE_WEBHOOK_SECRET is set the
# server is taking payments, so it refuses to send codes to the log: a buyer
# who cannot get a code cannot reach what they paid for.
# LOG_SIGNIN_CODES=true         # override that, for a staging copy only

# Option A: Microsoft Graph. All four are required, or it falls back to logging.
# The app registration needs the Mail.Send APPLICATION permission with admin
# consent granted, and GRAPH_SENDER must be a real mailbox in the tenant.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=the-secret-VALUE-not-the-secret-id
# The secret's expiry date from the app registration; the server warns 30 days ahead.
GRAPH_SECRET_EXPIRES=2028-11-24
GRAPH_SENDER=login@satlockin.com
# GRAPH_SAVE_TO_SENT=true

# Option B: Resend. Note the default onboarding@resend.dev sender only
# delivers to your own Resend account address until you verify a domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=SAT LockIn <login@satlockin.com>

APP_NAME=SAT LockIn
CODES_PER_HOUR=8

# --- AI: the coach agent and question analysis (paid; server side only, never in the browser) ---
# AI_DAILY_LIMIT caps AI requests per student per day. Each coach session costs one.
#
# Production signs in to Anthropic by workload identity federation (OIDC): no
# stored key. Set these four from the Claude Console (SETUP-CLOUD.md, Part 3).
# Render then sets ANTHROPIC_IDENTITY_TOKEN_FILE itself; never set it by hand.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
#
# Local development only: an API key. Ignored whenever the federation
# variables above are set. Never put one on the production service.
# ANTHROPIC_API_KEY=sk-ant-...
AI_DAILY_LIMIT=40

# --- Fresh questions: the shared pool (needs the AI and a database) ---
# When a session leaves a student with fewer than 2 unseen questions for a
# move, the server writes a few new ones in the background, has a second
# model check each one blind, and keeps the ones that pass in a pool every
# student shares. Students never pay for this from AI_DAILY_LIMIT.
# POOL_DAILY_LIMIT caps questions asked of the writer per UTC day, across the
# whole server (0 turns writing off). POOL_MAX_PER_MOVE caps the pool per move.
# POOL_DAILY_LIMIT=30
# POOL_MAX_PER_MOVE=40
# WRITER_MODEL=claude-opus-5-5
# VERIFIER_MODEL=claude-sonnet-5-5

# --- Payments (see SETUP-CLOUD.md, Part 4) ---
# The signing secret of the Stripe webhook endpoint pointed at
# https://<your-domain>/api/billing/webhook. Only a call signed with it can
# mark an account as paid.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Addresses with access without paying (you, a tester). Comma separated.
# COMP_EMAILS=you@example.com

# --- Local testing only, never in production ---
# ALLOW_CODE_IN_RESPONSE=true   # returns the sign-in code in the API response
# ALLOW_ANON_TUTOR=true         # question analysis with no accounts, capped by ANON_DAILY_BUDGET
# ANON_DAILY_BUDGET=60

# --- Hosting and database tuning, rarely needed ---
# PORT=8080                     # Render sets this for you
# ALLOWED_ORIGINS=https://satlockin.com   # only if the app is hosted elsewhere with CONFIG.apiUrl pointing here
# PG_POOL_MAX=5                 # database connections per server process
# PGSSL=true                    # force TLS to Postgres, certificate verified (sslmode=require in the URL also works)
# PGSSL_NO_VERIFY=true          # skip certificate checks for a private CA; avoid
# SKIP_DB_INIT=true             # do not apply db/schema.sql on boot (then apply it yourself before deploying)

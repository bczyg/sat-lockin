# Copy to .env for local use, or paste these into Railway -> Variables.
# Every one is optional. With none set, the app serves offline single-student
# practice, which is the whole app minus accounts, class view, and AI.

# --- Accounts, class dashboard, cross-device progress ---
# Railway sets this for you when you add the Postgres plugin. Reference it in
# your service variables as ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Sending the 6 digit sign-in code ---
# With nothing set here, the code is written to the server log instead of
# emailed, which is enough for testing.

# Option A: Microsoft Graph. All four are required, or it falls back to logging.
# The app registration needs the Mail.Send APPLICATION permission with admin
# consent granted, and GRAPH_SENDER must be a real mailbox in the tenant.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=the-secret-VALUE-not-the-secret-id
GRAPH_SENDER=login@satlockin.com
# GRAPH_SAVE_TO_SENT=true

# Option B: Resend. Note the default onboarding@resend.dev sender only
# delivers to your own Resend account address until you verify a domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=SAT LockIn <login@satlockin.com>

APP_NAME=SAT LockIn
CODES_PER_HOUR=8

# --- AI tutor and question writing (server side only, never in the browser) ---
ANTHROPIC_API_KEY=sk-ant-...
AI_DAILY_LIMIT=40

# --- Local testing only, never in production ---
# ALLOW_CODE_IN_RESPONSE=true   # returns the sign-in code in the API response
# ALLOW_ANON_TUTOR=true         # tutor with no accounts, capped by ANON_DAILY_BUDGET
# ANON_DAILY_BUDGET=60
